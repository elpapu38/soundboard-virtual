{
  "name": "soundboard-virtual",
  "version": "1.0.2",
  "description": "Soundboard de escritorio con salida a micrófono virtual",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder",
    "release": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --publish always"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.tuusuario.soundboardvirtual",
    "productName": "SoundBoard Virtual",
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elpapu38",
        "repo": "soundboard-virtual"
      }
    ]
  }
}
